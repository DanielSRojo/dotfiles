#!/bin/sh
# Replicate zellij's MoveFocusOrTab for herdr.
#
# zellij binds Alt+h / Alt+l to MoveFocusOrTab: focus the pane in that
# direction, and when the focused pane is already at the edge of its tab, fall
# through to the neighbouring tab instead. herdr keeps pane focus and tab
# switching as separate actions with no fall-through of its own, so this script
# joins them and is bound to alt+h / alt+l from config.toml.
#
# Every herdr call below deliberately omits a pane target: the socket API then
# resolves the UI-focused pane, which is what a keybinding wants. The HERDR_*
# env vars a pane inherits would instead pin this to whichever pane spawned it.

set -eu

dir=${1:-}
case "$dir" in
left | right) ;;
*)
	echo "usage: ${0##*/} left|right" >&2
	exit 2
	;;
esac

# Fast path: a pane exists that way, so this is an ordinary focus move. Kept
# free of a JSON parser because it is the overwhelmingly common case and runs on
# every keypress; `neighbor_pane_id` is absent from the response exactly when
# the focused pane sits at the edge of its tab.
if herdr pane neighbor --direction "$dir" 2>/dev/null | grep -q '"neighbor_pane_id"'; then
	exec herdr pane focus --direction "$dir"
fi

# At the edge, so wrap to the adjacent tab. Tabs are filtered to the focused
# tab's own workspace so this never leaks into another one, and the index wraps
# with a modulo so the strip is an endless cycle in both directions.
target=$(herdr tab list 2>/dev/null | python3 -c '
import json, sys

try:
    tabs = json.load(sys.stdin)["result"]["tabs"]
except (ValueError, KeyError):
    sys.exit(0)

focused = next((t for t in tabs if t.get("focused")), None)
if focused is None:
    sys.exit(0)

siblings = [t for t in tabs if t.get("workspace_id") == focused.get("workspace_id")]
if len(siblings) < 2:
    sys.exit(0)

step = -1 if sys.argv[1] == "left" else 1
print(siblings[(siblings.index(focused) + step) % len(siblings)]["tab_id"])
' "$dir")

if [ -n "$target" ]; then
	exec herdr tab focus "$target"
fi
