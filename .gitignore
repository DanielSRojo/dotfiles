.DS_Store
fish/conf.d/*work*.fish
jj/conf.d/*work*.toml

# Machine-local state that lives beside tracked config
atuin/atuin-receipt.json

# Fish rewrites this on every session and it holds absolute, per-machine paths
fish/fish_variables

# Regenerated by ~/.config/omarchy/hooks/theme-set.d/zellij-theme-from-omarchy
# on every `omarchy theme set`, so its contents are per-machine output.
zellij/themes/omarchy.kdl
