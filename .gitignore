.DS_Store
jj/conf.d/*work*.toml
nushell/autoload/*work*.nu

# Machine-local state that lives beside tracked config
atuin/atuin-receipt.json

# Fish rewrites this on every session and it holds absolute, per-machine paths
fish/fish_variables

# Nushell writes these into its config dir, which stow points at this repo:
# command history and the plugin registry are both machine-local state.
nushell/history.txt
nushell/history.sqlite3*
nushell/plugin.msgpackz

# LazyVim rewrites this to record the NEWS.md revision you have dismissed, so it
# diverges per machine. Kept out of the tree entirely rather than just untracked:
# stow reads the filesystem, not the index, so a leftover file here would collide
# with the live one and abort the whole run.
nvim/lazyvim.json

# Everything under these directories is generated or machine-local: fisher
# installs plugin files into $__fish_config_dir, which stow points at this repo,
# and work-machine snippets live in conf.d too. Track only the files we author —
# an allowlist cannot go stale the way a list of plugin filenames would.
# fish_plugins is the source of truth for what fisher reinstalls on each machine.
fish/completions/*
fish/functions/*
!fish/functions/__surround_with_parens.fish
fish/themes/*
fish/conf.d/*
!fish/conf.d/abbr.fish
!fish/conf.d/surround.fish

# Per-machine ghostty overrides (see the config-file include at the end of ghostty/config).
ghostty/config.local

# jj writes its repo-scoped config here (`jj config set --repo`), into the dir
# stow points at this repo. Each subdirectory is named for a hash of one
# checkout's absolute path and holds a metadata.binpb pointing back at it, so
# nothing in here can apply on another machine even if it were tracked.
jj/repos/

# herdr keeps its live session state in the same directory as its config, which
# stow points at this repo: unix sockets, the server/client logs, the restored
# session snapshot and the plugin lockfile are all machine-local runtime output.
# Today stow links config.toml individually and these never enter the tree --
# this guards the case where the directory gets folded and they do.
herdr/*.sock
herdr/*.log
herdr/session.json
herdr/.plugins.lock
