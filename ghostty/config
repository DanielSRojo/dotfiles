font-family = "MonaspiceAr Nerd Font"
# Monaspace faces are metric-compatible: Radon (handwriting) for italics makes
# comments recede in nvim. Applies to all italic text, not just comments.
font-family-italic = "MonaspiceRn Nerd Font"
font-style = Regular
font-size = "13"
# Monaspace gates its ligatures behind stylistic sets; `liga` alone does nothing
# here. `calt` is on by default, but it is listed because it also drives texture
# healing (the contextual widening of i/l and narrowing of m/w) — `-calt` would
# silently turn that off too.
font-feature = calt
# ss01 Equal Symbols:     != !== == #= /= -~ !~
font-feature = ss01
# ss02 Comparisons:       >= <=
font-feature = ss02
# ss03 Arrows:            -> --> <- <-- <-> <--> <!-- <~
font-feature = ss03
# ss04 HTML Tags:         the < and / tag forms
font-feature = ss04
# ss06 Markdown Strings:  ## ### === ___ +++ &&
font-feature = ss06
# ss07 Centered Colon:    :: ::: := =:
font-feature = ss07
# ss08 Centered Period:   . on the operator axis
font-feature = ss08
# ss09 Double Arrows:     => ==> >> >>= <== <==> =<<
font-feature = ss09

# Both machines drive the same 27" 1440p panel (~109 PPI, non-retina), so the
# sizing below is shared rather than per-machine. Extra leading keeps long log
# output legible when glyphs get few pixels.
adjust-cell-height = 8%

# macOS-only renderer options (no-ops on Linux, where freetype-load-flags rules).
# macOS dropped subpixel AA in Mojave, so text renders thin on a non-retina
# panel; thicken compensates. Strength defaults to 255 (max), which is too heavy
# for Argon's already-round stems.
font-thicken = true
font-thicken-strength = 200

auto-update = off

confirm-close-surface = false

# zellij can serialize a resurrection layout that has lost every terminal pane
# (seen 2026-08-29, and again 2026-09-19: the tab held only the tab-bar and
# status-bar plugins). Resurrecting that has nothing to run, so zellij prints
# "Bye from Zellij!" and exits *with status 0* — `||` never fires — the pty
# closes and the window vanishes at launch.
#
# The husk is self-perpetuating, which is why this recurs on every boot rather
# than once: nothing ever rewrites it. A SIGTERM'd server writes no layout at
# all, and exiting the last pane deletes the session outright, so neither
# teardown path regenerates the file — while the failed resurrect dies far too
# fast to serialize anything new over it. Once written it traps every attach
# until the session is deleted by hand.
#
# So guard on elapsed time (status can't see it) and repair instead of merely
# reporting: a session that dies within 3s has its state cleared and is retried
# once. Only if that also dies do we drop to a shell that says why, keeping the
# window up. A real quit takes longer and still closes. Discarding resurrection
# state here is safe — a session that dies that fast has none worth keeping.
initial-command = t=$(date +%s); zellij attach --create main; s=$?; [ $(($(date +%s)-t)) -lt 3 ] && { echo "zellij died in <3s (status $s); clearing stale session state"; zellij delete-session main --force; t=$(date +%s); zellij attach --create main; [ $(($(date +%s)-t)) -lt 3 ] && { echo "still dying immediately; dropping to a shell"; exec fish; }; }

mouse-hide-while-typing = true
mouse-scroll-multiplier = 2

# themes/ayu-dark in this directory, not ghostty's bundled Ayu: the palette is
# taken from zellij's builtin ayu-dark, the newer cut, so the window and zellij's
# chrome share a background instead of showing a seam.
theme = ayu-dark

window-theme = ghostty
window-decoration = none
window-width = 165
window-height = 46
window-padding-x = 8
window-padding-y = 6
resize-overlay = never
gtk-toolbar-style = flat

cursor-style = "block"
cursor-style-blink = false

# Cursor styling + SSH session terminfo
# (all shell integration options must be passed together)
shell-integration-features = no-cursor,ssh-env

keybind = global:f12=toggle_quick_terminal
quick-terminal-position = center
quick-terminal-autohide = true

keybind = shift+insert=paste_from_clipboard
keybind = control+insert=copy_to_clipboard
# Send Shift+Enter as CSI-u so TUIs can distinguish it from Enter.
keybind = shift+enter=csi:13;2u
# Legacy encoding sends Alt+Shift+Enter the same as Alt+Enter; send CSI-u so tmux can match M-S-Enter.
keybind = alt+shift+enter=csi:13;4u
keybind = super+control+shift+alt+arrow_down=resize_split:down,100
keybind = super+control+shift+alt+arrow_up=resize_split:up,100
keybind = super+control+shift+alt+arrow_left=resize_split:left,100
keybind = super+control+shift+alt+arrow_right=resize_split:right,100

# Fix general slowness on hyprland (https://github.com/ghostty-org/ghostty/discussions/3224)
async-backend = epoll

# Per-machine overrides. Optional (`?`) and relative to this file, so it is a
# no-op wherever it does not exist. Loaded last, so it wins over everything above.
config-file = ?"config.local"
