font-family = "FiraCode Nerd Font"
font-size = "14"
font-feature = calt
font-feature = liga
font-feature = ss01
font-feature = ss02
font-feature = ss03

auto-update = off

confirm-close-surface = false

initial-command = zellij attach --create main

mouse-hide-while-typing = true

theme = Ayu

window-decoration = none
window-width = 165
window-height = 46
window-padding-x = 8
window-padding-y = 6

keybind = global:f12=toggle_quick_terminal
quick-terminal-position = center
quick-terminal-autohide = true

# Per-machine overrides. Resolved relative to this file's directory once stowed,
# i.e. ~/.config/ghostty/config.local. Kept untracked (see .gitignore) so each
# machine can differ; the leading ? makes it optional, so machines without one
# load fine. The macOS box wants:
#   command = /run/current-system/sw/bin/fish --login --interactive
#   font-thicken = true
config-file = ?config.local
