font-family = "Monaspace Neon"
font-size = "14"
font-feature = calt
font-feature = liga
font-feature = ss01
font-feature = ss02
font-feature = ss03

auto-update = off

confirm-close-surface = false

initial-command = zellij attach --create main

mouse-hide-while-typing = true

# macOS-only renderer option (does not affect Linux)
font-thicken = true

theme = Ayu

window-decoration = none
window-width = 165
window-height = 46
window-padding-x = 8
window-padding-y = 6

keybind = global:f12=toggle_quick_terminal
quick-terminal-position = center
quick-terminal-autohide = true
