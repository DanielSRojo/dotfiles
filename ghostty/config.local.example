# Per-machine ghostty overrides, included optionally from `config`.
#
# To activate on a machine:
#
#     cp ghostty/config.local.example ghostty/config.local && stow .
#
# config.local is gitignored, so each machine keeps its own without ever
# conflicting with the others. Delete anything below you no longer want.
#
# What follows is what the macOS box ran before the shared config was unified
# on the Linux values.

# --- Needed on macOS ---------------------------------------------------------

# fish comes from nix-darwin rather than /etc/shells, so ghostty cannot pick it
# up as the login shell and needs the store path spelled out.
command = /run/current-system/sw/bin/fish --login --interactive

# macOS-only renderer option; parses everywhere but only has an effect there.
font-thicken = true

# --- Restores the previous macOS appearance ----------------------------------

# font-family is a fallback *list*, so assigning it here would append behind the
# shared FiraCode rather than replace it. The empty value clears the list first.
font-family =
font-family = "Monaspace Neon"

font-size = "16"
theme = "Gruvbox Dark"
window-padding-x = 10
window-padding-y = 10

# The shared config hides the titlebar and fixes the window size for the Linux
# box. Uncomment to get the native macOS titlebar and default sizing back.
# window-decoration = auto
# window-width = 0
# window-height = 0
