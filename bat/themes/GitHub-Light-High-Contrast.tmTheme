<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!--
  GitHub Light High Contrast — bat tmTheme
  Colors: Primer's light_high_contrast "prettylights" syntax palette, as shipped
  by projekt0n/github-nvim-theme (palette/primitives/light_high_contrast.lua).
  bat's bundled "GitHub" theme is the regular light one, not high contrast.

  bg       = #FFFFFF   canvas
  fg       = #0E1116   fg, plain variables, punctuation
  comment  = #4B535D   comment; also gutter, separators, diff headers
  ui.line  = #E7ECF0   canvas.subtle, line highlight
  select   = #CDDBF0   accent blended 20% into the canvas, as the nvim theme does
  caret    = #0349B4   accent
  keyword  = #A0111F   keywords, storage, operators, exceptions
  entity   = #512598   functions, classes, attribute names
  tag      = #024C1A   entityTag; also regexps and escapes (stringRegexp)
  string   = #032563
  constant = #023B95   numbers, constants, headings, links
  changed  = #702C00   markupChanged; also warnings
  error    = #6E011A   on #FFF0EE (invalidIllegal / markupDeleted)
  vcs      = #024C1A added / #702C00 modified / #6E011A removed, #622CBC range
-->
<dict>
  <key>name</key>   <string>GitHub Light High Contrast</string>
  <key>author</key> <string>Primer / projekt0n (tmTheme port)</string>
  <key>settings</key>
  <array>

    <!-- ── Global ─────────────────────────────────────────────── -->
    <dict>
      <key>settings</key>
      <dict>
        <key>background</key>              <string>#FFFFFF</string>
        <key>foreground</key>              <string>#0E1116</string>
        <key>caret</key>                   <string>#0349B4</string>
        <key>invisibles</key>              <string>#4B535D</string>
        <key>lineHighlight</key>           <string>#E7ECF0</string>
        <key>selection</key>               <string>#CDDBF0</string>
        <key>selectionBorder</key>         <string>#9CD7FF</string>
        <key>findHighlight</key>           <string>#CDDBF0</string>
        <key>findHighlightForeground</key> <string>#0E1116</string>
        <key>gutterForeground</key>        <string>#4B535D</string>
      </dict>
    </dict>

    <!-- ── Comments ───────────────────────────────────────────── -->
    <dict>
      <key>name</key>  <string>Comment</string>
      <key>scope</key> <string>comment, meta.documentation</string>
      <key>settings</key>
      <dict>
        <key>foreground</key> <string>#4B535D</string>
        <key>fontStyle</key>  <string>italic</string>
      </dict>
    </dict>

    <!-- ── Strings ────────────────────────────────────────────── -->
    <dict>
      <key>name</key>  <string>String</string>
      <key>scope</key> <string>string</string>
      <key>settings</key><dict><key>foreground</key><string>#032563</string></dict>
    </dict>
    <dict>
      <key>name</key>  <string>Regexp</string>
      <key>scope</key> <string>string.regexp</string>
      <key>settings</key><dict><key>foreground</key><string>#024C1A</string></dict>
    </dict>
    <dict>
      <key>name</key>  <string>Escape Character</string>
      <key>scope</key> <string>constant.character.escape</string>
      <key>settings</key><dict><key>foreground</key><string>#024C1A</string></dict>
    </dict>
    <dict>
      <key>name</key>  <string>String Punctuation</string>
      <key>scope</key> <string>punctuation.definition.string</string>
      <key>settings</key><dict><key>foreground</key><string>#032563</string></dict>
    </dict>

    <!-- ── Numbers & Constants ────────────────────────────────── -->
    <dict>
      <key>name</key>  <string>Number</string>
      <key>scope</key> <string>constant.numeric</string>
      <key>settings</key><dict><key>foreground</key><string>#023B95</string></dict>
