      <key>settings</key><dict><key>foreground</key><string>#FF8F40</string></dict>
    </dict>
    <dict>
      <key>name</key>  <string>Import Keyword</string>
      <key>scope</key> <string>meta.import keyword, keyword.control.import, keyword.control.import.from, keyword.other.import, keyword.control.at-rule.include, keyword.control.at-rule.import</string>
