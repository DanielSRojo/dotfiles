{
  "plugins": [
    "opencode-claude-auth@latest"
  ],
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "codegraph": {
      "type": "local",
      "command": [
        "codegraph",
        "serve",
        "--mcp"
      ],
      "enabled": true
    },
    "servers": {
      "astrokube": {
        "type": "remote",
        "url": "https://astroplatform-api.arcelormittal.digital/v2/mcp",
        "oauth": {
          "client_id": "claude-code",
          "callback_port": 33418,
          "redirect_uri": "http://localhost:33418/callback"
        },
        "headers": {
          "X-Astrokube-Organization": "arcelormittal",
          "X-Astrokube-Project": "management"
        }
      }
    }
  }
}
