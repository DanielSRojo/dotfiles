{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "github"
  },
  "plugins": [
    {
      "package": "@leohenon/opencode-vim-plugin@beta",
      "options": {
        "enabled": true,
        "vim_enter_submit": true,
        "vim_insert_after_submit": true
      }
    }
  ],
  "keybinds": {
    "input.newline": "shift+return,ctrl+j"
  },
  "diffs": {
    "wrap": "word"
  },
  "session": {
    "sidebar": "auto",
    "scrollbar": false,
    "thinking": "show"
  },
  "animations": true,
  "tabs": {
    "mode": "off"
  },
  "prompt": {
    "editor": true
  }
}
