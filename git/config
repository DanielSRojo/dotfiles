# Read by git alongside ~/.gitconfig (which keeps identity and the per-org
# includeIf blocks, so it stays untracked). Delta is configured here because jj
# pages through it too (ui.pager in jj/config.toml) and delta reads git config.

[delta]
    navigate = true  # use n and N to move between diff sections
    # No `light`/`dark` and no `syntax-theme`: delta asks the terminal which one it
    # is (detect-dark-light defaults to auto) and picks its own default syntax
    # theme for that mode. It has no per-mode syntax-theme to point at bat/themes.
