#!/bin/bash

# Pick the default audio output or input from the Omarchy (Quickshell) menu.
#
# Omarchy ships omarchy-audio-output-switch, which rotates one sink per key
# press, and nothing at all for inputs. That shape is right for two devices and
# wrong for more: this asks which device to use instead. Where the two overlap
# -- the sink selection, the exclusions, the closing OSD -- it does what
# omarchy-audio-output-switch does, so the cycle key and this one agree.
#
# One script rather than two because the menu is most of it. Only the gathering,
# the set-default command and the OSD at the end differ between the sides, and
# the omarchy-audio-<side>-set-default names line up with the argument.

set -euo pipefail

side=${1-}
case $side in
  output | input) ;;
  *)
    echo "Usage: audio-device-select <output|input>" >&2
    exit 1
    ;;
esac

# Keep the devices whose ports say they are actually there. A device with no
# ports at all -- a virtual sink, a filter chain -- has nothing to report and
# stays in the list.
available_devices() {
  timeout 2 pactl -f json list "$1" |
    jq '[.[] | select((.ports | length == 0) or ([.ports[]? | .availability != "not available"] | any))]'
}

if [[ $side == output ]]; then
  # Skip the physical sink an active speaker tuning fronts: selecting it would
  # silently bypass the tuning rather than pick a different output.
  fronted=$(omarchy-audio-tuning fronted-sink 2>/dev/null || true)
  devices=$(available_devices sinks |
    jq --arg fronted "$fronted" 'map(select($fronted == "" or .name != $fronted))')
  current_name=$(timeout 2 pactl get-default-sink)
  prompt="Audio output"
  empty_message="No audio outputs found"
  glyph="󰓃"
else
  # Every sink also publishes a monitor source, which is a recording tap on the
  # speakers rather than a microphone. A monitor carries the sink's own
  # media.class, so the real inputs are the ones calling themselves Audio/Source
  # -- the same test the shell's audio panel makes.
  devices=$(available_devices sources |
    jq 'map(select(.properties."media.class" == "Audio/Source"))')
  current_name=$(timeout 2 pactl get-default-source)
  prompt="Audio input"
  empty_message="No audio inputs found"
  glyph="󰍬"
fi

if (( $(jq 'length' <<<"$devices") == 0 )); then
  omarchy-osd -m "$empty_message"
  exit 1
fi

# The menu hands back the label and nothing else, so labels have to be unique:
# devices sharing a description -- a second headset of the same model, both
# inputs of one interface -- get their device name appended. The current device
# is marked with the ✓ the Omarchy menu already uses for a checked row.
rows=$(jq -r --arg current "$current_name" '
  def describe: .description // .properties."device.description" // .name;
  (map(describe) | group_by(.) | map(select(length > 1)[0])) as $ambiguous
  | .[]
  | describe as $description
  | (if $ambiguous | index($description) then "\($description) — \(.name)" else $description end) as $label
  | [(if .name == $current then "\($label) ✓" else $label end), .name, (.index | tostring)]
  | @tsv' <<<"$devices")

declare -A device_name_by_label device_index_by_label
options=()
while IFS=$'\t' read -r label name index; do
  options+=("$glyph"$'\t'"$label")
  device_name_by_label[$label]=$name
  device_index_by_label[$label]=$index
done <<<"$rows"

# The menu elides a label that overruns the card, and its 300 default is far too
# narrow for a description like "Navi 21/23 HDMI/DP Audio Controller Digital
# Stereo (HDMI 2) [G2721P]" -- the part that tells two devices apart is usually
# the tail. 520 is what Omarchy's own widest menus ask for, and it is a
# Style.space() unit rather than a pixel, so it grows with the shell font;
# anything wider than the screen is clamped to the panel, so this cannot
# overflow.
#
# Dismissing the menu is not a failure, it is "keep the device I have".
selection=$(omarchy-menu-select "$prompt" "${options[@]}" -- --width 520) || exit 0

next_name=${device_name_by_label[$selection]:-}
if [[ -z $next_name ]]; then
  echo "audio-device-select: no $side for selection: $selection" >&2
  exit 1
fi

next_device=$(jq -c --arg name "$next_name" 'map(select(.name == $name))[0]' <<<"$devices")
next_description=$(jq -r '.description // .properties."device.description" // .name' <<<"$next_device")

if [[ $next_name != "$current_name" ]]; then
  "omarchy-audio-${side}-set-default" "${device_index_by_label[$selection]}" "$next_name"
fi

if [[ $side == output ]]; then
  # A tuning sink sits at a fixed 100% and unmuted while real loudness lives on
  # the physical sink beneath it, so read the level from whichever sink actually
  # carries it or the OSD contradicts the volume keys.
  effective_sink=$(omarchy-audio-output-sink "$next_name")
  volume=$(timeout 2 pactl get-sink-volume "$effective_sink" 2>/dev/null |
    awk 'NR == 1 {for (i = 1; i <= NF; i++) if ($i ~ /%$/) {sub("%", "", $i); print $i; exit}}')
  [[ -n $volume ]] ||
    volume=$(jq -r '.volume | to_entries[0].value.value_percent | sub("%"; "") | tonumber' <<<"$next_device")

  if [[ $(timeout 2 pactl get-sink-mute "$effective_sink" 2>/dev/null) == *yes ]] || (( volume == 0 )); then
    icon_state="muted"
  elif (( volume <= 33 )); then
    icon_state="low"
  elif (( volume <= 66 )); then
    icon_state="medium"
  else
    icon_state="high"
  fi

  omarchy-osd -i "volume-${icon_state}" -m "$next_description"
else
  # The OSD icon set has a microphone and a muted microphone and nothing in
  # between, so an input reports the mute state the mic key toggles rather than
  # a level. Picking a muted input is worth seeing.
  if [[ $(timeout 2 pactl get-source-mute "$next_name" 2>/dev/null) == *yes ]]; then
    omarchy-osd -i microphone-muted -m "$next_description"
  else
    omarchy-osd -i microphone -m "$next_description"
  fi
fi
