#!/bin/bash

# Re-apply Ctrl+N/J + Ctrl+P/K navigation to the omarchy-shell plugins that
# need a clone to carry it (see omarchy/bin/vim-nav-clones.py).
#
# Runs after `omarchy update`: each clone is recreated from the freshly updated
# package and re-patched, so a clone never lags upstream by more than one
# update. omarchy-hook runs these with `bash`, ignoring shebangs, so this stays
# a bash wrapper around the Python applier.

set -e

exec python3 "$HOME/.config/omarchy/bin/vim-nav-clones.py"
